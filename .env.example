# Required
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
ADMIN_SECRET=change-me-before-deploying
MINISTRY_NAME=Celebration Church International

# Full sermon listing endpoint — the page/perPage query string is appended directly
# (e.g. https://sermons-api.example.com/sermons)
SERMON_BASE_URL=

# Base URL prepended to relative audio paths returned by the sermon API
# (e.g. https://cdn.example.com). A trailing slash is fine — it is normalised.
AUDIO_BASE_URL=

# Optional (defaults shown)
DB_PATH=./data/sermons.db
PORT=3000
MAX_AUDIO_DURATION_SECONDS=7200

# On Railway: set to /app/data/models so the embedder model persists across deploys.
# Leave unset locally — defaults to ~/.cache/xenova.
# XENOVA_CACHE=/app/data/models

# R2 / Litestream (optional — replication is skipped if any of these are unset)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
