# Required
ANTHROPIC_API_KEY=sk-ant-...
ADMIN_SECRET=change-me-before-deploying
MINISTRY_NAME=Celebration Church International

# Optional (defaults shown)
DB_PATH=./data/sermons.db
PORT=3000
MAX_AUDIO_DURATION_SECONDS=7200
WHISPER_MODEL=medium.en

# Base URL for sermon audio files (e.g. https://sermons.example.com)
# SERMON_BASE_URL=

# On Railway: set to /app/data/models so the embedder model persists across deploys.
# Leave unset locally — defaults to ~/.cache/xenova.
# XENOVA_CACHE=/app/data/models
