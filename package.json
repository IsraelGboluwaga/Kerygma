{
  "name": "kerygma",
  "version": "1.0.0",
  "description": "Church sermon knowledge base — admin ingests MP3 sermons, church members query via MCP",
  "type": "module",
  "main": "dist/main.js",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"tsx watch src/main.ts\" \"vite --config client/vite.config.ts\"",
    "build": "node scripts/esbuild.mjs && vite build --config client/vite.config.ts",
    "start": "NODE_ENV=production node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit && tsc --noEmit --project client/tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "@hono/node-server": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.10.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.4.5",
    "hono": "^4.12.23",
    "marked": "^18.0.5",
    "node-cron": "^4.2.1",
    "openai": "^6.42.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "winston": "^3.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/marked": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^2.0.0",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
