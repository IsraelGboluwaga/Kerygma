{
  "name": "kerygma",
  "version": "1.0.0",
  "description": "Church sermon knowledge base — admin ingests MP3 sermons, church members query via MCP",
  "type": "module",
  "main": "dist/main.js",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "build": "yarn build:web && yarn build:server",
    "build:server": "node scripts/esbuild.mjs",
    "build:web": "yarn workspace kerygma-frontend build",
    "dev": "concurrently -k -n server,web -c blue,magenta \"yarn dev:server\" \"yarn dev:web\"",
    "dev:server": "tsx watch src/main.ts",
    "dev:web": "yarn workspace kerygma-frontend dev",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "typecheck:web": "yarn workspace kerygma-frontend typecheck",
    "build:sdk": "yarn workspace @kerygma/sdk build",
    "typecheck:sdk": "yarn workspace @kerygma/sdk typecheck",
    "lint": "eslint src"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "@hono/node-server": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.10.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.4.5",
    "hono": "^4.12.23",
    "node-cron": "^4.2.1",
    "openai": "^6.42.0",
    "pdfkit": "^0.19.0",
    "winston": "^3.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^2.0.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
